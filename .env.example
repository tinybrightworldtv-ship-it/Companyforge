# CompanyForge server-side persistence
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Prefer the server-only secret key for autonomous workers. Never expose it in browser code.
SUPABASE_SECRET_KEY=
# Optional: use a signed user access token when operating under user RLS instead.
SUPABASE_ACCESS_TOKEN=
# Publishable key is suitable for user-scoped clients when RLS is configured.
SUPABASE_PUBLISHABLE_KEY=

# Multi-provider LLM execution (server-side only)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-2.5-flash

META_API_KEY=
META_MODEL=
# Optional Meta/Llama endpoint override
META_API_URL=

# Command Center event ingestion
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only event writer; never prefix with NEXT_PUBLIC_
INTERNAL_EVENT_INGEST_SECRET=
# Optional comma-separated browser origins allowed to submit public analytics events
PUBLIC_EVENT_ALLOWED_ORIGINS=
